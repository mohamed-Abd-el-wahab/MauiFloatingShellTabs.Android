<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MauiFloatingTabBar.Android</AssemblyName>
    <RootNamespace>MauiFloatingTabBar.Android</RootNamespace>

    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>MohamedAbdelwahab.FloatingTabBar.Android</PackageId>
    <Version>1.0.0</Version>
    <Authors>Moh</Authors>
    <Description>Reusable floating Android Shell tab bar for .NET MAUI apps.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>maui;android;shell;tabbar</PackageTags>
    <PackageProjectUrl>https://github.com/mohamed-Abd-el-wahab/MauiFloatingTabBar</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/mohamed-Abd-el-wahab/MauiFloatingTabBar</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageOutputPath>../LocalPackages</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.30" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="Platforms/Android/Resources/values/styles.xml"
          Pack="true"
          PackagePath="contentFiles/any/any/Platforms/Android/Resources/values/" />
    <None Include="buildTransitive/MohamedAbdelwahab.FloatingTabBar.Android.targets"
          Pack="true"
          PackagePath="buildTransitive/MohamedAbdelwahab.FloatingTabBar.Android.targets" />
  </ItemGroup>
</Project>
